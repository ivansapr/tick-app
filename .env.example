# Tick API Configuration
# Server: public origin used for MCP OAuth discovery and authorization.
# Set this in your deployment environment (server.js does not load .env.local).
# MCP_PUBLIC_URL=https://your-app.example.com
# Behind one ingress proxy (Docker defaults to 1). Adjust to your proxy topology.
# TRUST_PROXY=1
# Optional Claude client override; no Tick credential variables are needed.
# TICK_MCP_URL=http://localhost:3000/mcp

# Copy this file to .env.local and fill in your values

# Base URL for Tick API (default: https://www.tickspot.com)
REACT_APP_TICK_BASE_URL=https://www.tickspot.com

# Optional: Enable service worker in development
# REACT_APP_DEV_SERVICE_WORKER=true

# Umami Analytics (optional)
# VITE_UMAMI_SCRIPT_URL=https://your-umami-instance/script.js
# VITE_UMAMI_WEBSITE_ID=your-website-id
